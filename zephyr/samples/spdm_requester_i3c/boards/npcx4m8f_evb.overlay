 *
 * I3C controller-side overlay for the libspdm SPDM requester sample
 * on the Nuvoton NPCX4M8F EVB. Mirrors the wiring used by the
 * upstream samples/subsys/pmci/mctp/i3c_bus_host overlay for the same
 * board: I3C SDA on J18.20, SCL on J18.19. The MCTP endpoint matches
 * the spdm_responder_i3c sample's target PID 0x000020a/0x00000011 and
 * MCTP EID 11.
 */

&rctl {
	status = "okay";
};

&i3c0 {
	status = "okay";
	i3c-scl-hz = <7500000>;
	i3c-od-scl-hz = <1500000>;

	bcr = <0x67>;

	mctp_endpoint0: mctp_endpoint0@20a00000011 {
		compatible = "zephyr,mctp-i3c-endpoint";
		reg = <0x0000 0x020a 0x00000011>;
		status = "okay";
	};
};

&pcc {
	clock-frequency = <DT_FREQ_M(90)>;
	core-prescaler = <3>;
	apb1-prescaler = <6>;
	apb2-prescaler = <6>;
	apb3-prescaler = <6>;
	apb4-prescaler = <3>;
};

/ {
	mctp_i3c: mctp_i3c {
		compatible = "zephyr,mctp-i3c-controller";
		endpoints = <&mctp_endpoint0>;
		endpoint-ids = <11>;
	};
};
