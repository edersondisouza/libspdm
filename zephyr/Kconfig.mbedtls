#
# mbedTLS feature requirements pulled in when CONFIG_LIBSPDM_CRYPTO_MBEDTLS=y.
#
# Each entry is declared as a bool so Kconfig parses cleanly across mbedTLS
# versions:
#  * Symbols that already exist in Zephyr's mbedtls module (CONFIG_MBEDTLS_*)
#    get their default extended to "y" -> they propagate into the generated
#    mbedtls config the same way the user's prj.conf would.
#  * Symbols that no longer exist as Kconfig in modern mbedTLS (the v4 +
#    TF-PSA-Crypto split moved a number of MBEDTLS_*_C macros to a generated
#    config header) become harmless local bools. The demo application is
#    expected to provide the corresponding #defines through
#    CONFIG_MBEDTLS_USER_CONFIG_FILE -- see samples/.../prj.conf in Phase 3.
#
# The minimum feature set targets SPDM 1.2/1.3 over ECDSA P-256/P-384,
# RSA-PSS 2048/3072, ECDHE, AES-GCM 128/256, SHA-256/384/512, HKDF and
# X.509 parsing. Optional algorithms (ChaCha20-Poly1305, SHA-3, Ed25519,
# SM2/SM3/SM4, PQC) stay off by default so the footprint stays small.

if LIBSPDM_CRYPTO_MBEDTLS

# Hashing
config MBEDTLS_MD_C
	bool
	default y
config MBEDTLS_SHA256_C
	bool
	default y
config MBEDTLS_SHA384_C
	bool
	default y
config MBEDTLS_SHA512_C
	bool
	default y

# HKDF / HMAC
config MBEDTLS_HKDF_C
	bool
	default y

# AEAD: AES-GCM
config MBEDTLS_AES_C
	bool
	default y
config MBEDTLS_GCM_C
	bool
	default y
config MBEDTLS_CIPHER_C
	bool
	default y
config MBEDTLS_CIPHER_MODE_CBC
	bool
	default y

# Public-key crypto: ECDSA + ECDHE on NIST P-256/P-384
config MBEDTLS_ECP_C
	bool
	default y
config MBEDTLS_ECDH_C
	bool
	default y
config MBEDTLS_ECDSA_C
	bool
	default y
config MBEDTLS_ECDSA_DETERMINISTIC
	bool
	default y
config MBEDTLS_ECP_DP_SECP256R1_ENABLED
	bool
	default y
config MBEDTLS_ECP_DP_SECP384R1_ENABLED
	bool
	default y

# RSA-PSS (sample chains can use RSA leaves)
config MBEDTLS_RSA_C
	bool
	default y
config MBEDTLS_PKCS1_V21
	bool
	default y

# Generic PK + ASN.1
config MBEDTLS_PK_C
	bool
	default y
config MBEDTLS_PK_PARSE_C
	bool
	default y
config MBEDTLS_PK_WRITE_C
	bool
	default y
config MBEDTLS_ASN1_PARSE_C
	bool
	default y
config MBEDTLS_ASN1_WRITE_C
	bool
	default y
config MBEDTLS_OID_C
	bool
	default y
config MBEDTLS_BIGNUM_C
	bool
	default y

# X.509 certificate parsing
config MBEDTLS_X509_LIBRARY
	bool
	default y
config MBEDTLS_X509_USE_C
	bool
	default y
config MBEDTLS_X509_CRT_PARSE_C
	bool
	default y

# PEM key parsing (sample keys ship as PEM as well as DER)
config MBEDTLS_PEM_PARSE_C
	bool
	default y
config MBEDTLS_BASE64_C
	bool
	default y

# Entropy / DRBG (rnglib uses sys_csrand_get directly, but mbedtls itself
# still needs a DRBG for ECDSA blinding).
config MBEDTLS_CTR_DRBG_C
	bool
	default y
config MBEDTLS_ENTROPY_C
	bool
	default y

endif # LIBSPDM_CRYPTO_MBEDTLS
